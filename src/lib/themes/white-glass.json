{
  "$schema": "https://raw.githubusercontent.com/TMlauncher/omnilauncher/main/schemas/theme.schema.json",
  "id": "white-glass",
  "name": "Белое стекло (White Glass)",
  "author": "OmniLauncher Team",
  "version": "1.0.0",
  "description": "Светлое полупрозрачное матовое стекло в стиле frosted acrylic",
  "accentStyle": "specular",
  "vibrancy": "acrylic",
  "tokens": {
    "--bg-canvas": "rgba(235, 240, 248, 0.78)",
    "--bg-surface": "rgba(255, 255, 255, 0.65)",
    "--bg-surface-base": "rgba(255, 255, 255, 0.65)",
    "--bg-surface-elevated": "rgba(255, 255, 255, 0.82)",
    "--bg-surface-floating": "rgba(255, 255, 255, 0.95)",
    "--bg-surface-glass": "rgba(255, 255, 255, 0.50)",
    "--chrome-gradient": "linear-gradient(180deg, rgba(255,255,255,0.8) 0%, rgba(240,242,248,0.6) 100%)",
    "--chrome-border": "linear-gradient(135deg, rgba(255,255,255,0.9) 0%, rgba(200,210,225,0.4) 100%)",
    "--chrome-specular": "rgba(255, 255, 255, 0.95)",
    "--chrome-ribbon": "linear-gradient(90deg, rgba(255,255,255,0.4) 0%, rgba(59,130,246,0.5) 50%, rgba(255,255,255,0.4) 100%)",
    "--border-hairline": "rgba(0, 0, 0, 0.08)",
    "--border-subtle": "rgba(0, 0, 0, 0.12)",
    "--border-active": "rgba(59, 130, 246, 0.5)",
    "--border-specular": "rgba(255, 255, 255, 0.95)",
    "--text-primary": "#0f172a",
    "--text-secondary": "#334155",
    "--text-muted": "#64748b",
    "--text-accent": "#0284c7",
    "--accent-primary": "#0284c7",
    "--accent-primary-contrast": "#ffffff",
    "--accent-metallic": "#94a3b8",
    "--accent-chrome": "linear-gradient(135deg, #0284c7 0%, #38bdf8 100%)",
    "--accent-glow": "0 0 24px rgba(2, 132, 199, 0.22)",
    "--status-success": "#16a34a",
    "--status-warning": "#d97706",
    "--status-danger": "#dc2626",
    "--status-info": "#0284c7",
    "--shadow-card": "0 8px 24px -4px rgba(100, 116, 139, 0.18)",
    "--shadow-card-hover": "0 16px 36px -6px rgba(100, 116, 139, 0.28), 0 0 20px rgba(2, 132, 199, 0.15)",
    "--shadow-modal": "0 24px 60px -12px rgba(15, 23, 42, 0.25)",
    "--shadow-specular": "inset 0 1px 0 rgba(255, 255, 255, 0.8)",
    "--radius-xs": "6px",
    "--radius-sm": "10px",
    "--radius-md": "14px",
    "--radius-lg": "18px",
    "--radius-xl": "24px",
    "--radius-full": "9999px",
    "--font-sans": "'Inter', -apple-system, BlinkMacSystemFont, sans-serif",
    "--font-mono": "'JetBrains Mono', monospace",
    "--font-heading-tracking": "0.06em",
    "--font-heading-weight": "700",
    "--poster-filter": "none",
    "--poster-filter-hover": "none",
    "--backdrop-blur": "24px"
  },
  "media": {
    "backgroundVideo": null,
    "ambientAudio": null,
    "audioVolume": 0.2
  }
}
