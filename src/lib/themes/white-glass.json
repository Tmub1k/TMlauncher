{
  "$schema": "https://raw.githubusercontent.com/TMlauncher/omnilauncher/main/schemas/theme.schema.json",
  "id": "white-glass",
  "name": "Светлое Стекло (Светлая)",
  "author": "OmniLauncher Team",
  "version": "2.0.0",
  "description": "Светлый фон, полупрозрачные белые панели, читаемый тёмный текст и сапфировый акцент",
  "accentStyle": "specular",
  "vibrancy": "acrylic",
  "tokens": {
    "--bg-canvas": "#f1f5f9",
    "--bg-surface": "#ffffff",
    "--bg-surface-base": "#ffffff",
    "--bg-surface-elevated": "#f8fafc",
    "--bg-surface-floating": "#ffffff",
    "--bg-surface-glass": "rgba(255, 255, 255, 0.92)",
    "--chrome-gradient": "linear-gradient(180deg, #ffffff 0%, #e2e8f0 100%)",
    "--chrome-border": "linear-gradient(135deg, rgba(79, 70, 229, 0.2) 0%, rgba(15, 23, 42, 0.06) 100%)",
    "--chrome-specular": "rgba(255, 255, 255, 0.95)",
    "--chrome-ribbon": "linear-gradient(90deg, #cbd5e1 0%, #4f46e5 50%, #cbd5e1 100%)",
    "--border-hairline": "rgba(15, 23, 42, 0.08)",
    "--border-subtle": "rgba(15, 23, 42, 0.12)",
    "--border-active": "rgba(79, 70, 229, 0.50)",
    "--border-specular": "rgba(255, 255, 255, 0.95)",
    "--text-primary": "#0f172a",
    "--text-secondary": "#334155",
    "--text-muted": "#64748b",
    "--text-accent": "#4f46e5",
    "--accent-primary": "#4f46e5",
    "--accent-primary-contrast": "#ffffff",
    "--accent-metallic": "#6366f1",
    "--accent-chrome": "linear-gradient(135deg, #4f46e5 0%, #3b82f6 100%)",
    "--accent-glow": "0 0 24px rgba(79, 70, 229, 0.20)",
    "--status-success": "#16a34a",
    "--status-warning": "#d97706",
    "--status-danger": "#dc2626",
    "--status-info": "#0284c7",
    "--shadow-card": "0 8px 24px -4px rgba(100, 116, 139, 0.15)",
    "--shadow-card-hover": "0 16px 36px -6px rgba(100, 116, 139, 0.25), 0 0 20px rgba(79, 70, 229, 0.15)",
    "--shadow-modal": "0 24px 60px -12px rgba(15, 23, 42, 0.18)",
    "--shadow-specular": "inset 0 1px 0 rgba(255, 255, 255, 0.8)",
    "--radius-xs": "6px",
    "--radius-sm": "10px",
    "--radius-md": "14px",
    "--radius-lg": "18px",
    "--radius-xl": "24px",
    "--radius-full": "9999px",
    "--font-sans": "'Inter', -apple-system, BlinkMacSystemFont, sans-serif",
    "--font-mono": "'JetBrains Mono', monospace",
    "--font-heading-tracking": "0.06em",
    "--font-heading-weight": "700",
    "--poster-filter": "none",
    "--poster-filter-hover": "none",
    "--backdrop-blur": "24px"
  },
  "media": {
    "backgroundVideo": null,
    "ambientAudio": null,
    "audioVolume": 0.2
  }
}
