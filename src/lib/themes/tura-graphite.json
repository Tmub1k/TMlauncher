{
  "$schema": "https://raw.githubusercontent.com/TMlauncher/omnilauncher/main/schemas/theme.schema.json",
  "id": "tura-graphite",
  "name": "Тёмный Графит (Основная)",
  "author": "OmniLauncher Team",
  "version": "2.0.0",
  "description": "Глубокий графитовый фон, строгий минимализм и индиго акцент",
  "accentStyle": "matte",
  "vibrancy": "mica",
  "tokens": {
    "--bg-canvas": "#09090b",
    "--bg-surface": "#121215",
    "--bg-surface-base": "#121215",
    "--bg-surface-elevated": "#18181c",
    "--bg-surface-floating": "#202026",
    "--bg-surface-glass": "rgba(18, 18, 21, 0.85)",
    "--chrome-gradient": "linear-gradient(180deg, #27272a 0%, #121215 100%)",
    "--chrome-border": "linear-gradient(135deg, rgba(255, 255, 255, 0.15) 0%, rgba(255, 255, 255, 0.03) 100%)",
    "--chrome-specular": "rgba(255, 255, 255, 0.35)",
    "--chrome-ribbon": "linear-gradient(90deg, #3f3f46 0%, #6366f1 50%, #3f3f46 100%)",
    "--border-hairline": "rgba(255, 255, 255, 0.06)",
    "--border-subtle": "rgba(255, 255, 255, 0.10)",
    "--border-active": "rgba(99, 102, 241, 0.50)",
    "--border-specular": "rgba(255, 255, 255, 0.50)",
    "--text-primary": "#ffffff",
    "--text-secondary": "#a1a1aa",
    "--text-muted": "#71717a",
    "--text-accent": "#818cf8",
    "--accent-primary": "#6366f1",
    "--accent-primary-contrast": "#ffffff",
    "--accent-metallic": "#818cf8",
    "--accent-chrome": "linear-gradient(135deg, #6366f1 0%, #4f46e5 100%)",
    "--accent-glow": "0 0 24px rgba(99, 102, 241, 0.25)",
    "--status-success": "#10b981",
    "--status-warning": "#f59e0b",
    "--status-danger": "#ef4444",
    "--status-info": "#0ea5e9",
    "--shadow-card": "0 10px 30px -10px rgba(0, 0, 0, 0.8)",
    "--shadow-card-hover": "0 20px 40px -12px rgba(0, 0, 0, 0.95), 0 0 24px rgba(99, 102, 241, 0.15)",
    "--shadow-modal": "0 25px 60px -15px rgba(0, 0, 0, 0.95)",
    "--shadow-specular": "inset 0 1px 0 rgba(255, 255, 255, 0.12)",
    "--radius-xs": "4px",
    "--radius-sm": "8px",
    "--radius-md": "12px",
    "--radius-lg": "16px",
    "--radius-xl": "22px",
    "--radius-full": "9999px",
    "--font-sans": "'Cera CY', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif",
    "--font-mono": "'JetBrains Mono', 'Fira Code', monospace",
    "--font-heading-tracking": "0.08em",
    "--font-heading-weight": "800",
    "--poster-filter": "grayscale(40%) contrast(105%) brightness(95%)",
    "--poster-filter-hover": "grayscale(0%) contrast(102%) brightness(100%)",
    "--backdrop-blur": "20px"
  },
  "media": {
    "backgroundVideo": null,
    "ambientAudio": null,
    "audioVolume": 0.2
  }
}
