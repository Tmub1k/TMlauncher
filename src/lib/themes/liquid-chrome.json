{
  "$schema": "https://raw.githubusercontent.com/TMlauncher/omnilauncher/main/schemas/theme.schema.json",
  "id": "liquid-chrome",
  "name": "Liquid Chrome Cyber",
  "author": "OmniLauncher Team",
  "version": "1.0.0",
  "description": "Specular liquid mercury ribbons, metallic chrome borders, brushed steel pill badges, fluid glass blocks",
  "accentStyle": "chrome",
  "vibrancy": "acrylic",
  "tokens": {
    "--bg-canvas": "#060709",
    "--bg-surface": "#0e1014",
    "--bg-surface-base": "#0e1014",
    "--bg-surface-elevated": "#161920",
    "--bg-surface-floating": "#1e222b",
    "--bg-surface-glass": "rgba(14, 16, 20, 0.82)",
    "--chrome-gradient": "linear-gradient(180deg, #505663 0%, #1e222a 50%, #0d0f13 100%)",
    "--chrome-border": "linear-gradient(135deg, #ffffff 0%, #8e95a5 35%, #2a2e38 70%, #ffffff 100%)",
    "--chrome-specular": "rgba(255, 255, 255, 0.75)",
    "--chrome-ribbon": "linear-gradient(90deg, #2b303c 0%, #e8edf5 35%, #ffffff 50%, #9aa3b2 65%, #181a20 100%)",
    "--border-hairline": "rgba(212, 216, 226, 0.12)",
    "--border-subtle": "rgba(212, 216, 226, 0.20)",
    "--border-active": "rgba(255, 255, 255, 0.50)",
    "--border-specular": "rgba(255, 255, 255, 0.85)",
    "--text-primary": "#f4f6fa",
    "--text-secondary": "#b4b9c5",
    "--text-muted": "#6b7280",
    "--text-accent": "#ffffff",
    "--accent-primary": "#d4d8e2",
    "--accent-primary-contrast": "#060709",
    "--accent-metallic": "#e2e6f0",
    "--accent-chrome": "linear-gradient(135deg, #ffffff 0%, #c4cbd8 40%, #768092 80%, #ffffff 100%)",
    "--accent-glow": "0 0 28px rgba(212, 216, 226, 0.25)",
    "--status-success": "#10b981",
    "--status-warning": "#f59e0b",
    "--status-danger": "#ef4444",
    "--status-info": "#38bdf8",
    "--shadow-card": "0 12px 36px -10px rgba(0, 0, 0, 0.9)",
    "--shadow-card-hover": "0 24px 48px -12px rgba(0, 0, 0, 0.98), 0 0 30px rgba(212, 216, 226, 0.18)",
    "--shadow-modal": "0 30px 70px -15px rgba(0, 0, 0, 0.98)",
    "--shadow-specular": "inset 0 1px 1px rgba(255, 255, 255, 0.35)",
    "--radius-xs": "4px",
    "--radius-sm": "8px",
    "--radius-md": "12px",
    "--radius-lg": "16px",
    "--radius-xl": "22px",
    "--radius-full": "9999px",
    "--font-sans": "'Inter', 'Cera CY', -apple-system, BlinkMacSystemFont, sans-serif",
    "--font-mono": "'JetBrains Mono', 'Fira Code', monospace",
    "--font-heading-tracking": "0.1em",
    "--font-heading-weight": "900",
    "--poster-filter": "grayscale(40%) contrast(112%) brightness(98%)",
    "--poster-filter-hover": "grayscale(0%) contrast(105%) brightness(102%)",
    "--backdrop-blur": "24px"
  },
  "media": {
    "backgroundVideo": null,
    "ambientAudio": null,
    "audioVolume": 0.2
  }
}
