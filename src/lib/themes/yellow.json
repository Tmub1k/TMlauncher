{
  "$schema": "https://raw.githubusercontent.com/TMlauncher/omnilauncher/main/schemas/theme.schema.json",
  "id": "yellow",
  "name": "Киберпанк Янтарь",
  "author": "OmniLauncher Team",
  "version": "2.0.0",
  "description": "Киберпанковый золотисто-янтарный интерфейс с высокой контрастностью и угольным фоном",
  "accentStyle": "specular",
  "vibrancy": "mica",
  "tokens": {
    "--bg-canvas": "#120f07",
    "--bg-surface": "#1f190b",
    "--bg-surface-base": "#1f190b",
    "--bg-surface-elevated": "#2c240f",
    "--bg-surface-floating": "#3d3314",
    "--bg-surface-glass": "rgba(31, 25, 11, 0.88)",
    "--chrome-gradient": "linear-gradient(180deg, #3d3314 0%, #1f190b 100%)",
    "--chrome-border": "linear-gradient(135deg, rgba(245, 158, 11, 0.45) 0%, rgba(245, 158, 11, 0.08) 100%)",
    "--chrome-specular": "rgba(253, 224, 71, 0.5)",
    "--chrome-ribbon": "linear-gradient(90deg, #713f12 0%, #f59e0b 50%, #713f12 100%)",
    "--border-hairline": "rgba(245, 158, 11, 0.12)",
    "--border-subtle": "rgba(245, 158, 11, 0.20)",
    "--border-active": "rgba(245, 158, 11, 0.55)",
    "--border-specular": "rgba(253, 224, 71, 0.7)",
    "--text-primary": "#fefce8",
    "--text-secondary": "#fef08a",
    "--text-muted": "#ca8a04",
    "--text-accent": "#f59e0b",
    "--accent-primary": "#f59e0b",
    "--accent-primary-contrast": "#120f07",
    "--accent-metallic": "#fde047",
    "--accent-chrome": "linear-gradient(135deg, #f59e0b 0%, #d97706 100%)",
    "--accent-glow": "0 0 25px rgba(245, 158, 11, 0.35)",
    "--status-success": "#22c55e",
    "--status-warning": "#f59e0b",
    "--status-danger": "#ef4444",
    "--status-info": "#38bdf8",
    "--shadow-card": "0 10px 30px -10px rgba(0, 0, 0, 0.85)",
    "--shadow-card-hover": "0 20px 40px -12px rgba(0, 0, 0, 0.95), 0 0 24px rgba(245, 158, 11, 0.25)",
    "--shadow-modal": "0 25px 60px -15px rgba(0, 0, 0, 0.95)",
    "--shadow-specular": "inset 0 1px 0 rgba(253, 224, 71, 0.25)",
    "--radius-xs": "4px",
    "--radius-sm": "8px",
    "--radius-md": "12px",
    "--radius-lg": "16px",
    "--radius-xl": "22px",
    "--radius-full": "9999px",
    "--font-sans": "'Inter', -apple-system, BlinkMacSystemFont, sans-serif",
    "--font-mono": "'JetBrains Mono', monospace",
    "--font-heading-tracking": "0.06em",
    "--font-heading-weight": "700",
    "--poster-filter": "none",
    "--poster-filter-hover": "none",
    "--backdrop-blur": "18px"
  },
  "media": {
    "backgroundVideo": null,
    "ambientAudio": null,
    "audioVolume": 0.2
  }
}
