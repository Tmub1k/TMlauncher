{
  "$schema": "https://raw.githubusercontent.com/TMlauncher/omnilauncher/main/schemas/theme.schema.json",
  "id": "cyber-aurora",
  "name": "Кибер-Аврора (Неон)",
  "author": "OmniLauncher Team",
  "version": "2.0.0",
  "description": "Тёмно-синий космический холст с бирюзово-фиолетовым неоновым сиянием",
  "accentStyle": "iridescent",
  "vibrancy": "mica",
  "tokens": {
    "--bg-canvas": "#070b19",
    "--bg-surface": "#0f172a",
    "--bg-surface-base": "#0f172a",
    "--bg-surface-elevated": "#1e293b",
    "--bg-surface-floating": "#334155",
    "--bg-surface-glass": "rgba(15, 23, 42, 0.88)",
    "--chrome-gradient": "linear-gradient(180deg, #1e293b 0%, #0f172a 100%)",
    "--chrome-border": "linear-gradient(135deg, rgba(6, 182, 212, 0.4) 0%, rgba(168, 85, 247, 0.25) 50%, rgba(255,255,255,0.05) 100%)",
    "--chrome-specular": "rgba(6, 182, 212, 0.6)",
    "--chrome-ribbon": "linear-gradient(90deg, #1e1b4b 0%, #06b6d4 40%, #a855f7 60%, #1e1b4b 100%)",
    "--border-hairline": "rgba(6, 182, 212, 0.12)",
    "--border-subtle": "rgba(6, 182, 212, 0.20)",
    "--border-active": "rgba(6, 182, 212, 0.55)",
    "--border-specular": "rgba(6, 182, 212, 0.70)",
    "--text-primary": "#f8fafc",
    "--text-secondary": "#cbd5e1",
    "--text-muted": "#64748b",
    "--text-accent": "#06b6d4",
    "--accent-primary": "#06b6d4",
    "--accent-primary-contrast": "#070b19",
    "--accent-metallic": "#a855f7",
    "--accent-chrome": "linear-gradient(135deg, #06b6d4 0%, #a855f7 100%)",
    "--accent-glow": "0 0 28px rgba(6, 182, 212, 0.30)",
    "--status-success": "#34d399",
    "--status-warning": "#fbbf24",
    "--status-danger": "#f87171",
    "--status-info": "#06b6d4",
    "--shadow-card": "0 10px 30px -10px rgba(0, 0, 0, 0.85)",
    "--shadow-card-hover": "0 20px 40px -12px rgba(0, 0, 0, 0.95), 0 0 24px rgba(6, 182, 212, 0.25)",
    "--shadow-modal": "0 25px 65px -15px rgba(0, 0, 0, 0.95)",
    "--shadow-specular": "inset 0 1px 0 rgba(6, 182, 212, 0.3)",
    "--radius-xs": "4px",
    "--radius-sm": "8px",
    "--radius-md": "12px",
    "--radius-lg": "16px",
    "--radius-xl": "22px",
    "--radius-full": "9999px",
    "--font-sans": "'Inter', sans-serif",
    "--font-mono": "'JetBrains Mono', monospace",
    "--font-heading-tracking": "0.08em",
    "--font-heading-weight": "800",
    "--poster-filter": "grayscale(25%) contrast(106%) brightness(95%)",
    "--poster-filter-hover": "grayscale(0%) contrast(102%) brightness(100%)",
    "--backdrop-blur": "20px"
  },
  "media": {
    "backgroundVideo": null,
    "ambientAudio": null,
    "audioVolume": 0.2
  }
}
