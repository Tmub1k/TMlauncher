{
  "$schema": "https://raw.githubusercontent.com/TMlauncher/omnilauncher/main/schemas/theme.schema.json",
  "id": "glass",
  "name": "Стекло (Glass Dark)",
  "author": "OmniLauncher Team",
  "version": "1.0.0",
  "description": "Элегантное темное стекло с глубоким акриловым размытием и световыми гранями",
  "accentStyle": "specular",
  "vibrancy": "acrylic",
  "tokens": {
    "--bg-canvas": "rgba(10, 11, 16, 0.72)",
    "--bg-surface": "rgba(20, 22, 30, 0.55)",
    "--bg-surface-base": "rgba(20, 22, 30, 0.55)",
    "--bg-surface-elevated": "rgba(30, 34, 46, 0.65)",
    "--bg-surface-floating": "rgba(40, 45, 62, 0.80)",
    "--bg-surface-glass": "rgba(25, 28, 38, 0.50)",
    "--chrome-gradient": "linear-gradient(180deg, rgba(255,255,255,0.12) 0%, rgba(255,255,255,0.02) 100%)",
    "--chrome-border": "linear-gradient(135deg, rgba(255,255,255,0.35) 0%, rgba(255,255,255,0.08) 100%)",
    "--chrome-specular": "rgba(255, 255, 255, 0.60)",
    "--chrome-ribbon": "linear-gradient(90deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.7) 50%, rgba(255,255,255,0.1) 100%)",
    "--border-hairline": "rgba(255, 255, 255, 0.12)",
    "--border-subtle": "rgba(255, 255, 255, 0.18)",
    "--border-active": "rgba(255, 255, 255, 0.45)",
    "--border-specular": "rgba(255, 255, 255, 0.75)",
    "--text-primary": "#ffffff",
    "--text-secondary": "#cbd5e1",
    "--text-muted": "#94a3b8",
    "--text-accent": "#f8fafc",
    "--accent-primary": "#38bdf8",
    "--accent-primary-contrast": "#0f172a",
    "--accent-metallic": "#e2e8f0",
    "--accent-chrome": "linear-gradient(135deg, #ffffff 0%, #94a3b8 100%)",
    "--accent-glow": "0 0 25px rgba(56, 189, 248, 0.25)",
    "--status-success": "#34d399",
    "--status-warning": "#fbbf24",
    "--status-danger": "#f87171",
    "--status-info": "#38bdf8",
    "--shadow-card": "0 12px 32px -8px rgba(0, 0, 0, 0.55)",
    "--shadow-card-hover": "0 20px 48px -10px rgba(0, 0, 0, 0.7), 0 0 24px rgba(56, 189, 248, 0.2)",
    "--shadow-modal": "0 32px 72px -16px rgba(0, 0, 0, 0.8)",
    "--shadow-specular": "inset 0 1px 0 rgba(255, 255, 255, 0.25)",
    "--radius-xs": "6px",
    "--radius-sm": "10px",
    "--radius-md": "14px",
    "--radius-lg": "18px",
    "--radius-xl": "24px",
    "--radius-full": "9999px",
    "--font-sans": "'Inter', -apple-system, BlinkMacSystemFont, sans-serif",
    "--font-mono": "'JetBrains Mono', monospace",
    "--font-heading-tracking": "0.06em",
    "--font-heading-weight": "700",
    "--poster-filter": "none",
    "--poster-filter-hover": "none",
    "--backdrop-blur": "24px"
  },
  "media": {
    "backgroundVideo": null,
    "ambientAudio": null,
    "audioVolume": 0.2
  }
}
