{
  "$schema": "https://raw.githubusercontent.com/TMlauncher/omnilauncher/main/schemas/theme.schema.json",
  "id": "cyber-aurora",
  "name": "Cyber Aurora",
  "author": "OmniLauncher Team",
  "version": "1.0.0",
  "description": "Dark titanium canvas with iridescent blue-violet reflections and icy platinum highlights",
  "accentStyle": "iridescent",
  "vibrancy": "mica",
  "tokens": {
    "--bg-canvas": "#08090d",
    "--bg-surface": "#0f1118",
    "--bg-surface-base": "#0f1118",
    "--bg-surface-elevated": "#171b26",
    "--bg-surface-floating": "#202534",
    "--bg-surface-glass": "rgba(15, 17, 24, 0.85)",
    "--chrome-gradient": "linear-gradient(180deg, #2a3449 0%, #151a24 100%)",
    "--chrome-border": "linear-gradient(135deg, rgba(147, 197, 253, 0.4) 0%, rgba(192, 132, 252, 0.2) 50%, rgba(255,255,255,0.05) 100%)",
    "--chrome-specular": "rgba(147, 197, 253, 0.6)",
    "--chrome-ribbon": "linear-gradient(90deg, #1e293b 0%, #93c5fd 40%, #c084fc 60%, #1e1b4b 100%)",
    "--border-hairline": "rgba(147, 197, 253, 0.12)",
    "--border-subtle": "rgba(147, 197, 253, 0.20)",
    "--border-active": "rgba(192, 132, 252, 0.45)",
    "--border-specular": "rgba(147, 197, 253, 0.70)",
    "--text-primary": "#f8fafc",
    "--text-secondary": "#cbd5e1",
    "--text-muted": "#64748b",
    "--text-accent": "#93c5fd",
    "--accent-primary": "#93c5fd",
    "--accent-primary-contrast": "#08090d",
    "--accent-metallic": "#c084fc",
    "--accent-chrome": "linear-gradient(135deg, #93c5fd 0%, #c084fc 50%, #38bdf8 100%)",
    "--accent-glow": "0 0 28px rgba(147, 197, 253, 0.25)",
    "--status-success": "#34d399",
    "--status-warning": "#fbbf24",
    "--status-danger": "#f87171",
    "--status-info": "#38bdf8",
    "--shadow-card": "0 10px 30px -10px rgba(0, 0, 0, 0.85)",
    "--shadow-card-hover": "0 20px 40px -12px rgba(0, 0, 0, 0.95), 0 0 24px rgba(147, 197, 253, 0.2)",
    "--shadow-modal": "0 25px 65px -15px rgba(0, 0, 0, 0.95)",
    "--shadow-specular": "inset 0 1px 0 rgba(147, 197, 253, 0.3)",
    "--radius-xs": "4px",
    "--radius-sm": "8px",
    "--radius-md": "12px",
    "--radius-lg": "16px",
    "--radius-xl": "22px",
    "--radius-full": "9999px",
    "--font-sans": "'Inter', sans-serif",
    "--font-mono": "'JetBrains Mono', monospace",
    "--font-heading-tracking": "0.08em",
    "--font-heading-weight": "800",
    "--poster-filter": "grayscale(50%) contrast(108%) brightness(95%)",
    "--poster-filter-hover": "grayscale(0%) contrast(102%) brightness(100%)",
    "--backdrop-blur": "20px"
  },
  "media": {
    "backgroundVideo": null,
    "ambientAudio": null,
    "audioVolume": 0.2
  }
}
