{
  "$schema": "https://raw.githubusercontent.com/TMlauncher/omnilauncher/main/schemas/theme.schema.json",
  "id": "obsidian-pure",
  "name": "Obsidian Pure OLED",
  "author": "OmniLauncher Team",
  "version": "1.0.0",
  "description": "100% true black canvas for OLED displays with crisp white geometric accents",
  "accentStyle": "matte",
  "vibrancy": "none",
  "tokens": {
    "--bg-canvas": "#000000",
    "--bg-surface": "#090909",
    "--bg-surface-base": "#090909",
    "--bg-surface-elevated": "#121212",
    "--bg-surface-floating": "#1a1a1a",
    "--bg-surface-glass": "rgba(9, 9, 9, 0.90)",
    "--chrome-gradient": "linear-gradient(180deg, #262626 0%, #0d0d0d 100%)",
    "--chrome-border": "linear-gradient(135deg, rgba(255,255,255,0.3) 0%, rgba(255,255,255,0.05) 100%)",
    "--chrome-specular": "rgba(255, 255, 255, 0.5)",
    "--chrome-ribbon": "linear-gradient(90deg, #171717 0%, #ffffff 50%, #171717 100%)",
    "--border-hairline": "rgba(255, 255, 255, 0.12)",
    "--border-subtle": "rgba(255, 255, 255, 0.18)",
    "--border-active": "rgba(255, 255, 255, 0.45)",
    "--border-specular": "rgba(255, 255, 255, 0.70)",
    "--text-primary": "#ffffff",
    "--text-secondary": "#a3a3a3",
    "--text-muted": "#525252",
    "--text-accent": "#ffffff",
    "--accent-primary": "#ffffff",
    "--accent-primary-contrast": "#000000",
    "--accent-metallic": "#e5e5e5",
    "--accent-chrome": "linear-gradient(135deg, #ffffff 0%, #737373 100%)",
    "--accent-glow": "0 0 20px rgba(255, 255, 255, 0.15)",
    "--status-success": "#22c55e",
    "--status-warning": "#eab308",
    "--status-danger": "#f43f5e",
    "--status-info": "#06b6d4",
    "--shadow-card": "0 10px 30px -10px rgba(0, 0, 0, 1.0)",
    "--shadow-card-hover": "0 20px 40px -12px rgba(0, 0, 0, 1.0), 0 0 20px rgba(255, 255, 255, 0.1)",
    "--shadow-modal": "0 30px 80px -20px rgba(0, 0, 0, 1.0)",
    "--shadow-specular": "inset 0 1px 0 rgba(255, 255, 255, 0.2)",
    "--radius-xs": "2px",
    "--radius-sm": "6px",
    "--radius-md": "10px",
    "--radius-lg": "14px",
    "--radius-xl": "18px",
    "--radius-full": "9999px",
    "--font-sans": "'Inter', -apple-system, BlinkMacSystemFont, sans-serif",
    "--font-mono": "'JetBrains Mono', monospace",
    "--font-heading-tracking": "0.08em",
    "--font-heading-weight": "800",
    "--poster-filter": "grayscale(100%) contrast(115%)",
    "--poster-filter-hover": "grayscale(0%) contrast(105%)",
    "--backdrop-blur": "16px"
  },
  "media": {
    "backgroundVideo": null,
    "ambientAudio": null,
    "audioVolume": 0.2
  }
}
