{
  "$schema": "https://raw.githubusercontent.com/TMlauncher/omnilauncher/main/schemas/theme.schema.json",
  "id": "emerald-green",
  "name": "Зелёный (Emerald)",
  "author": "OmniLauncher Team",
  "version": "1.0.0",
  "description": "Глубокая изумрудная палитра с неоновым зеленым свечением и темным графитом",
  "accentStyle": "specular",
  "vibrancy": "mica",
  "tokens": {
    "--bg-canvas": "#070d0a",
    "--bg-surface": "#0c1511",
    "--bg-surface-base": "#0c1511",
    "--bg-surface-elevated": "#122019",
    "--bg-surface-floating": "#172921",
    "--bg-surface-glass": "rgba(12, 21, 17, 0.85)",
    "--chrome-gradient": "linear-gradient(180deg, #183325 0%, #0c1511 100%)",
    "--chrome-border": "linear-gradient(135deg, rgba(16,185,129,0.4) 0%, rgba(16,185,129,0.05) 100%)",
    "--chrome-specular": "rgba(52, 211, 153, 0.5)",
    "--chrome-ribbon": "linear-gradient(90deg, #064e3b 0%, #34d399 50%, #064e3b 100%)",
    "--border-hairline": "rgba(52, 211, 153, 0.10)",
    "--border-subtle": "rgba(52, 211, 153, 0.16)",
    "--border-active": "rgba(52, 211, 153, 0.45)",
    "--border-specular": "rgba(110, 231, 183, 0.65)",
    "--text-primary": "#f0fdf4",
    "--text-secondary": "#a7f3d0",
    "--text-muted": "#6ee7b7",
    "--text-accent": "#34d399",
    "--accent-primary": "#10b981",
    "--accent-primary-contrast": "#022c22",
    "--accent-metallic": "#6ee7b7",
    "--accent-chrome": "linear-gradient(135deg, #34d399 0%, #059669 100%)",
    "--accent-glow": "0 0 25px rgba(16, 185, 129, 0.35)",
    "--status-success": "#10b981",
    "--status-warning": "#f59e0b",
    "--status-danger": "#ef4444",
    "--status-info": "#06b6d4",
    "--shadow-card": "0 10px 30px -10px rgba(0, 0, 0, 0.85)",
    "--shadow-card-hover": "0 20px 40px -12px rgba(0, 0, 0, 0.95), 0 0 24px rgba(16, 185, 129, 0.2)",
    "--shadow-modal": "0 25px 60px -15px rgba(0, 0, 0, 0.95)",
    "--shadow-specular": "inset 0 1px 0 rgba(110, 231, 183, 0.25)",
    "--radius-xs": "4px",
    "--radius-sm": "8px",
    "--radius-md": "12px",
    "--radius-lg": "16px",
    "--radius-xl": "22px",
    "--radius-full": "9999px",
    "--font-sans": "'Inter', -apple-system, BlinkMacSystemFont, sans-serif",
    "--font-mono": "'JetBrains Mono', monospace",
    "--font-heading-tracking": "0.06em",
    "--font-heading-weight": "700",
    "--poster-filter": "none",
    "--poster-filter-hover": "none",
    "--backdrop-blur": "18px"
  },
  "media": {
    "backgroundVideo": null,
    "ambientAudio": null,
    "audioVolume": 0.2
  }
}
