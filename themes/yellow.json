{
  "$schema": "https://raw.githubusercontent.com/TMlauncher/omnilauncher/main/schemas/theme.schema.json",
  "id": "amber-yellow",
  "name": "Жёлтый (Amber Gold)",
  "author": "OmniLauncher Team",
  "version": "1.0.0",
  "description": "Киберпанковый золотисто-янтарный интерфейс с высокой контрастностью",
  "accentStyle": "specular",
  "vibrancy": "mica",
  "tokens": {
    "--bg-canvas": "#0d0c07",
    "--bg-surface": "#14130a",
    "--bg-surface-base": "#14130a",
    "--bg-surface-elevated": "#1e1b0d",
    "--bg-surface-floating": "#292410",
    "--bg-surface-glass": "rgba(20, 19, 10, 0.85)",
    "--chrome-gradient": "linear-gradient(180deg, #3d3408 0%, #14130a 100%)",
    "--chrome-border": "linear-gradient(135deg, rgba(234,179,8,0.4) 0%, rgba(234,179,8,0.05) 100%)",
    "--chrome-specular": "rgba(253, 224, 71, 0.5)",
    "--chrome-ribbon": "linear-gradient(90deg, #713f12 0%, #fde047 50%, #713f12 100%)",
    "--border-hairline": "rgba(234, 179, 8, 0.12)",
    "--border-subtle": "rgba(234, 179, 8, 0.18)",
    "--border-active": "rgba(234, 179, 8, 0.5)",
    "--border-specular": "rgba(253, 224, 71, 0.7)",
    "--text-primary": "#fefce8",
    "--text-secondary": "#fef08a",
    "--text-muted": "#ca8a04",
    "--text-accent": "#facc15",
    "--accent-primary": "#eab308",
    "--accent-primary-contrast": "#422006",
    "--accent-metallic": "#fde047",
    "--accent-chrome": "linear-gradient(135deg, #facc15 0%, #ca8a04 100%)",
    "--accent-glow": "0 0 25px rgba(234, 179, 8, 0.35)",
    "--status-success": "#22c55e",
    "--status-warning": "#eab308",
    "--status-danger": "#ef4444",
    "--status-info": "#38bdf8",
    "--shadow-card": "0 10px 30px -10px rgba(0, 0, 0, 0.85)",
    "--shadow-card-hover": "0 20px 40px -12px rgba(0, 0, 0, 0.95), 0 0 24px rgba(234, 179, 8, 0.2)",
    "--shadow-modal": "0 25px 60px -15px rgba(0, 0, 0, 0.95)",
    "--shadow-specular": "inset 0 1px 0 rgba(253, 224, 71, 0.25)",
    "--radius-xs": "4px",
    "--radius-sm": "8px",
    "--radius-md": "12px",
    "--radius-lg": "16px",
    "--radius-xl": "22px",
    "--radius-full": "9999px",
    "--font-sans": "'Inter', -apple-system, BlinkMacSystemFont, sans-serif",
    "--font-mono": "'JetBrains Mono', monospace",
    "--font-heading-tracking": "0.06em",
    "--font-heading-weight": "700",
    "--poster-filter": "none",
    "--poster-filter-hover": "none",
    "--backdrop-blur": "18px"
  },
  "media": {
    "backgroundVideo": null,
    "ambientAudio": null,
    "audioVolume": 0.2
  }
}
